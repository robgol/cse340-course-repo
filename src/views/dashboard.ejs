<%- include('partials/header') %>

<section class="py-16">
    <div class="max-container max-w-4xl mx-auto">
        <header class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4"><%= title %></h1>
            <div class="w-20 h-1 bg-secondary mx-auto"></div>
            <p class="mt-4 text-slate-600">Welcome to your dashboard. Here you can see your account details.</p>
        </header>

        <div class="bg-white p-8 rounded-card border border-outline shadow-sm overflow-hidden relative">
            <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/5 rounded-full -mr-16 -mt-16"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row items-center gap-8">
                <div class="w-24 h-24 bg-surface rounded-2xl flex items-center justify-center text-secondary">
                    <i data-lucide="user" class="w-12 h-12"></i>
                </div>
                
                <div class="flex-grow space-y-4">
                    <h2 class="text-2xl font-bold text-primary">Account Information</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-1">
                            <span class="text-sm font-bold text-slate-500 uppercase tracking-wider">Full Name</span>
                            <p class="text-lg font-semibold text-primary"><%= name %></p>
                        </div>
                        <div class="space-y-1">
                            <span class="text-sm font-bold text-slate-500 uppercase tracking-wider">Email Address</span>
                            <p class="text-lg font-semibold text-primary"><%= email %></p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="mt-12 pt-8 border-t border-outline flex flex-wrap gap-4">
                <% if (user && user.role_name === 'admin') { %>
                <a href="/users" class="px-6 py-3 bg-secondary text-white font-bold rounded-xl hover:bg-opacity-90 transition-all card-hover flex items-center gap-2">
                    <i data-lucide="users" class="w-5 h-5"></i> Manage Users
                </a>
                <% } %>
                <a href="/logout" class="px-6 py-3 bg-rose-500 text-white font-bold rounded-xl hover:bg-rose-600 transition-all card-hover flex items-center gap-2">
                    <i data-lucide="log-out" class="w-5 h-5"></i> Logout
                </a>
            </div>
        </div>

        <div class="mt-12">
            <h2 class="text-2xl font-bold text-primary mb-6 flex items-center gap-2">
                <i data-lucide="heart-handshake" class="w-6 h-6 text-secondary"></i> My Volunteering Projects
            </h2>
            
            <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
                <div class="grid grid-cols-1 gap-6">
                    <% volunteeredProjects.forEach(project => { %>
                        <div class="bg-white p-6 rounded-card border border-outline shadow-sm flex flex-col md:flex-row items-center gap-6 group hover:border-secondary transition-colors">
                            <div class="w-full md:w-32 h-24 rounded-xl overflow-hidden flex-shrink-0">
                                <img src="<%= project.image_url %>" alt="<%= project.title %>" class="w-full h-full object-cover">
                            </div>
                            <div class="flex-grow text-center md:text-left">
                                <h3 class="font-bold text-primary text-lg"><%= project.title %></h3>
                                <p class="text-slate-500 text-sm mb-2"><%= project.organization_name %></p>
                                <div class="flex flex-wrap justify-center md:justify-start gap-4 text-xs font-bold text-slate-400 uppercase tracking-widest">
                                    <span class="flex items-center gap-1"><i data-lucide="calendar" class="w-4 h-4"></i> <%= new Date(project.date).toLocaleDateString() %></span>
                                    <span class="flex items-center gap-1"><i data-lucide="map-pin" class="w-4 h-4"></i> <%= project.location %></span>
                                </div>
                            </div>
                            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                                <a href="/project/<%= project.project_id %>" class="px-4 py-2 bg-surface border border-outline text-primary font-bold rounded-xl hover:bg-outline transition-all text-center">View</a>
                                <a href="/project/<%= project.project_id %>/remove-volunteer" class="px-4 py-2 bg-rose-50 text-rose-500 font-bold rounded-xl hover:bg-rose-500 hover:text-white transition-all text-center">Remove</a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="bg-surface p-12 rounded-card border border-dashed border-outline text-center">
                    <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-slate-300 mx-auto mb-4 border border-outline">
                        <i data-lucide="users" class="w-8 h-8"></i>
                    </div>
                    <p class="text-slate-500 mb-6">You haven't volunteered for any projects yet.</p>
                    <a href="/projects" class="text-secondary font-bold hover:underline">Explore upcoming projects</a>
                </div>
            <% } %>
        </div>

        <div class="mt-16">
            <h2 class="text-2xl font-bold text-primary mb-6 flex items-center gap-2">
                <i data-lucide="heart" class="w-6 h-6 text-rose-500"></i> My Favorite Projects
            </h2>
            
            <% if (favoriteProjects && favoriteProjects.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <% favoriteProjects.forEach(project => { %>
                        <div class="bg-white p-6 rounded-card border border-outline shadow-sm flex flex-col items-start gap-4 group hover:border-rose-500 transition-colors relative">
                            <div class="w-full h-40 rounded-xl overflow-hidden mb-2">
                                <img src="<%= project.image_url %>" alt="<%= project.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="w-full">
                                <h3 class="font-bold text-primary text-lg mb-1"><%= project.title %></h3>
                                <p class="text-slate-500 text-sm mb-4"><%= project.organization_name %></p>
                                <div class="flex flex-wrap gap-4 text-xs font-bold text-slate-400 uppercase tracking-widest mb-6">
                                    <span class="flex items-center gap-1"><i data-lucide="calendar" class="w-4 h-4"></i> <%= new Date(project.date).toLocaleDateString() %></span>
                                </div>
                                <div class="flex gap-3 w-full">
                                    <a href="/project/<%= project.project_id %>" class="flex-grow px-4 py-2 bg-primary text-white text-center font-bold rounded-xl hover:bg-secondary transition-all">View Details</a>
                                    <a href="/project/<%= project.project_id %>/remove-favorite" class="px-4 py-2 bg-rose-50 text-rose-500 font-bold rounded-xl hover:bg-rose-500 hover:text-white transition-all" title="Remove Favorite">
                                        <i data-lucide="heart" class="w-5 h-5 fill-current"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="bg-surface p-12 rounded-card border border-dashed border-outline text-center">
                    <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-slate-300 mx-auto mb-4 border border-outline">
                        <i data-lucide="heart" class="w-8 h-8"></i>
                    </div>
                    <p class="text-slate-500 mb-6">You haven't saved any favorite projects yet.</p>
                    <a href="/projects" class="text-secondary font-bold hover:underline">Browse projects to save</a>
                </div>
            <% } %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
