<%- include('partials/header') %>

<section class="py-16">
    <div class="max-container">
        <header class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4"><%= title %></h1>
            <div class="w-20 h-1 bg-secondary mx-auto"></div>
            <p class="mt-4 text-slate-600">Manage all registered users and their roles.</p>
        </header>

        <div class="bg-white rounded-card border border-outline shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-surface border-b border-outline">
                        <tr>
                            <th class="px-6 py-4 font-bold text-primary uppercase tracking-wider text-sm">Name</th>
                            <th class="px-6 py-4 font-bold text-primary uppercase tracking-wider text-sm">Email</th>
                            <th class="px-6 py-4 font-bold text-primary uppercase tracking-wider text-sm">Role</th>
                            <th class="px-6 py-4 font-bold text-primary uppercase tracking-wider text-sm text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline">
                        <% users.forEach(user => { %>
                        <tr class="hover:bg-surface/50 transition-colors">
                            <td class="px-6 py-4 font-medium text-primary"><%= user.name %></td>
                            <td class="px-6 py-4 text-slate-600"><%= user.email %></td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase <%= user.role_name === 'admin' ? 'bg-secondary/10 text-secondary' : 'bg-slate-100 text-slate-600' %>">
                                    <%= user.role_name %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a href="/edit-user/<%= user.user_id %>" class="p-2 text-slate-400 hover:text-secondary hover:bg-surface rounded-lg transition-colors" title="Edit User">
                                        <i data-lucide="edit-3" class="w-5 h-5"></i>
                                    </a>
                                    <form action="/delete-user/<%= user.user_id %>" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                        <button type="submit" class="p-2 text-slate-400 hover:text-rose-500 hover:bg-rose-50 rounded-lg transition-colors" title="Delete User">
                                            <i data-lucide="trash-2" class="w-5 h-5"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="mt-8 flex justify-center">
            <a href="/dashboard" class="flex items-center gap-2 text-primary font-bold hover:text-secondary transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5"></i> Back to Dashboard
            </a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
