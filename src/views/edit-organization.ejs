<%- include('partials/header') %>

<section class="py-16">
    <div class="max-container max-w-2xl mx-auto">
        <header class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4"><%= title %></h1>
            <div class="w-20 h-1 bg-secondary mx-auto"></div>
            <p class="mt-4 text-slate-600">Update the organization details below.</p>
        </header>

        <div class="bg-white p-8 rounded-card border border-outline shadow-sm">
            <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" class="space-y-6">
                <div>
                    <label for="name" class="block text-sm font-bold text-slate-700 mb-2">Organization Name</label>
                    <input type="text" id="name" name="name" required maxlength="150" 
                        value="<%= organizationDetails.name %>"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                        placeholder="Enter organization name">
                </div>

                <div>
                    <label for="description" class="block text-sm font-bold text-slate-700 mb-2">Description</label>
                    <textarea id="description" name="description" rows="4" required maxlength="500"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                        placeholder="Tell us about your organization's mission and work"><%= organizationDetails.description %></textarea>
                </div>

                <div>
                    <label for="contactEmail" class="block text-sm font-bold text-slate-700 mb-2">Contact Email</label>
                    <input type="email" id="contactEmail" name="contactEmail" required maxlength="255"
                        value="<%= organizationDetails.contact_email %>"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                        placeholder="e.g., contact@organization.org">
                </div>


                <div class="pt-4">
                    <button type="submit" 
                        class="w-full py-4 bg-secondary text-white font-bold rounded-xl hover:bg-opacity-90 transition-all card-hover shadow-lg shadow-secondary/20">
                        Update Organization
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
