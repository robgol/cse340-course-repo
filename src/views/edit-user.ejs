<%- include('partials/header') %>

<section class="py-16">
    <div class="max-container max-w-2xl mx-auto">
        <header class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4"><%= title %></h1>
            <div class="w-20 h-1 bg-secondary mx-auto"></div>
            <p class="mt-4 text-slate-600">Update the user details and role below.</p>
        </header>

        <div class="bg-white p-8 rounded-card border border-outline shadow-sm">
            <form action="/edit-user/<%= userToEdit.user_id %>" method="POST" class="space-y-6">
                <div>
                    <label for="name" class="block text-sm font-bold text-slate-700 mb-2">Full Name</label>
                    <input type="text" id="name" name="name" required maxlength="100" 
                        value="<%= userToEdit.name %>"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                        placeholder="Enter full name">
                </div>

                <div>
                    <label for="email" class="block text-sm font-bold text-slate-700 mb-2">Email Address</label>
                    <input type="email" id="email" name="email" required maxlength="255"
                        value="<%= userToEdit.email %>"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                        placeholder="e.g., user@example.com">
                </div>

                <div>
                    <label for="role_id" class="block text-sm font-bold text-slate-700 mb-2">Role</label>
                    <select id="role_id" name="role_id" required
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all bg-white">
                        <% roles.forEach(role => { %>
                            <option value="<%= role.role_id %>" <%= userToEdit.role_id === role.role_id ? 'selected' : '' %>>
                                <%= role.role_name.charAt(0).toUpperCase() + role.role_name.slice(1) %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="pt-4 flex flex-col gap-4">
                    <button type="submit" 
                        class="w-full py-4 bg-secondary text-white font-bold rounded-xl hover:bg-opacity-90 transition-all card-hover shadow-lg shadow-secondary/20">
                        Update User
                    </button>
                    <a href="/users" class="w-full py-4 bg-slate-100 text-slate-600 text-center font-bold rounded-xl hover:bg-slate-200 transition-all">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
