<%- include('partials/header') %>

<section class="py-16">
    <div class="max-container max-w-2xl mx-auto">
        <header class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4"><%= title %></h1>
            <div class="w-20 h-1 bg-secondary mx-auto"></div>
            <p class="mt-4 text-slate-600">Update the details for <strong><%= project.title %></strong>.</p>
        </header>

        <div class="bg-white p-8 rounded-card border border-outline shadow-sm">
            <form action="/edit-project/<%= project.project_id %>" method="POST" class="space-y-6">
                <div>
                    <label for="title" class="block text-sm font-bold text-slate-700 mb-2">Project Title</label>
                    <input type="text" id="title" name="title" required maxlength="200" 
                        value="<%= project.title %>"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                        placeholder="Enter project title">
                </div>

                <div>
                    <label for="description" class="block text-sm font-bold text-slate-700 mb-2">Description</label>
                    <textarea id="description" name="description" rows="4" required maxlength="1000"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                        placeholder="Describe the service project"><%= project.description %></textarea>
                </div>

                <div>
                    <label for="location" class="block text-sm font-bold text-slate-700 mb-2">Location</label>
                    <input type="text" id="location" name="location" required maxlength="200"
                        value="<%= project.location %>"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all"
                        placeholder="e.g., City Hall, Main Street">
                </div>

                <div>
                    <label for="date" class="block text-sm font-bold text-slate-700 mb-2">Date</label>
                    <% 
                        // Format date to YYYY-MM-DD for the HTML date input
                        let formattedDate = '';
                        if (project.date) {
                            const d = new Date(project.date);
                            // Ensure we use the local date parts to avoid timezone shifts
                            const year = d.getFullYear();
                            const month = String(d.getMonth() + 1).padStart(2, '0');
                            const day = String(d.getDate()).padStart(2, '0');
                            formattedDate = `${year}-${month}-${day}`;
                        }
                    %>
                    <input type="date" id="date" name="date" required
                        value="<%= formattedDate %>"
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all">
                </div>

                <div>
                    <label for="organizationId" class="block text-sm font-bold text-slate-700 mb-2">Organization</label>
                    <select id="organizationId" name="organizationId" required
                        class="w-full px-4 py-3 rounded-lg border border-outline focus:border-secondary focus:ring-2 focus:ring-secondary/20 outline-none transition-all">
                        <option value="">Select an organization</option>
                        <% organizations.forEach(org => { %>
                            <option value="<%= org.organization_id %>" <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
                                <%= org.name %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="pt-4">
                    <label class="block text-sm font-bold text-slate-700 mb-4">Project Categories</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <% categories.forEach(category => { %>
                            <div class="flex items-center gap-3 p-3 border border-outline rounded-xl hover:border-secondary/50 hover:bg-surface transition-all cursor-pointer group">
                                <input
                                    type="checkbox"
                                    id="category-<%= category.category_id %>"
                                    name="categoryIds"
                                    value="<%= category.category_id %>"
                                    <%= assignedCategories.some(ac => ac.category_id === category.category_id) ? 'checked' : '' %>
                                    class="w-5 h-5 rounded border-outline text-secondary focus:ring-secondary focus:ring-offset-0 cursor-pointer transition-colors"
                                />
                                <label for="category-<%= category.category_id %>" class="flex-grow cursor-pointer text-sm font-medium text-slate-700 group-hover:text-secondary transition-colors">
                                    <%= category.name %>
                                </label>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit" 
                        class="w-full py-4 bg-secondary text-white font-bold rounded-xl hover:bg-opacity-90 transition-all card-hover shadow-lg shadow-secondary/20">
                        Update Project
                    </button>
                    <a href="/project/<%= project.project_id %>" class="block text-center mt-4 text-slate-500 hover:text-slate-700 font-medium transition-colors">
                        Cancel and return to project details
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
