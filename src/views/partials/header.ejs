<!-- Defines the header partial with navigation -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | CSE 340 Service Network</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0f172a',
                        secondary: '#0d9488',
                        accent: '#38bdf8',
                        surface: '#f8f9ff',
                        'surface-container': '#ffffff',
                        outline: '#e2e8f0',
                    },
                    fontFamily: {
                        sans: ['Manrope', 'sans-serif'],
                    },
                    borderRadius: {
                        'card': '12px',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/css/main.css">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- jQuery (required for Select2) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-surface text-primary min-h-screen flex flex-col">
    <header class="bg-surface-container border-b border-outline sticky top-0 z-50">
        <div class="max-container flex justify-between items-center h-20">
            <a href="/" class="flex items-center gap-2 text-2xl font-extrabold text-primary">
                <div class="w-10 h-10 bg-secondary rounded-lg flex items-center justify-center text-white">
                    <i data-lucide="heart-handshake"></i>
                </div>
                <span class="hidden sm:inline">CSE 340</span>
            </a>
            <nav>
                <ul class="flex gap-8 font-semibold items-center">
                    <li><a href="/" class="hover:text-secondary transition-colors <%= currentPath === '/' ? 'text-secondary font-bold' : '' %>">Home</a></li>
                    <li><a href="/organizations" class="hover:text-secondary transition-colors <%= currentPath.startsWith('/organization') ? 'text-secondary font-bold' : '' %>">Organizations</a></li>
                    <li><a href="/projects" class="hover:text-secondary transition-colors <%= currentPath.startsWith('/project') ? 'text-secondary font-bold' : '' %>">Projects</a></li>
                    <li><a href="/categories" class="hover:text-secondary transition-colors <%= currentPath.startsWith('/categor') ? 'text-secondary font-bold' : '' %>">Categories</a></li>
                    <% if (isLoggedIn) { %>
                        <li class="relative group">
                            <button class="flex items-center gap-1 hover:text-secondary transition-colors cursor-pointer">
                                My Account <i data-lucide="chevron-down" class="w-4 h-4"></i>
                            </button>
                            <div class="absolute right-0 mt-2 w-48 bg-white border border-outline rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-[60] py-2 overflow-hidden">
                                <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 hover:bg-surface hover:text-secondary transition-colors text-sm <%= currentPath === '/dashboard' ? 'text-secondary font-bold bg-surface' : 'text-primary' %>">
                                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
                                </a>
                                <% if (user && user.role_name === 'admin') { %>
                                    <a href="/users" class="flex items-center gap-3 px-4 py-3 hover:bg-surface hover:text-secondary transition-colors text-sm <%= currentPath === '/users' ? 'text-secondary font-bold bg-surface' : 'text-primary' %>">
                                        <i data-lucide="users" class="w-4 h-4"></i> User Management
                                    </a>
                                <% } %>
                                <div class="border-t border-outline my-1"></div>
                                <a href="/logout" class="flex items-center gap-3 px-4 py-3 hover:bg-rose-50 text-rose-500 transition-colors text-sm">
                                    <i data-lucide="log-out" class="w-4 h-4"></i> Logout
                                </a>
                            </div>
                        </li>
                    <% } else { %>
                        <li><a href="/register" class="hover:text-secondary transition-colors <%= currentPath === '/register' ? 'text-secondary font-bold' : '' %>">Register</a></li>
                        <li><a href="/login" class="hover:text-secondary transition-colors <%= currentPath === '/login' ? 'text-secondary font-bold' : '' %>">Login</a></li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </header>
    <main class="flex-grow">
    <% const messages = flash(); %>
    <script>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            <% messages[type].forEach(msg => { %>
                Swal.fire({
                    icon: '<%= type === "error" ? "error" : (type === "success" ? "success" : (type === "warning" ? "warning" : "info")) %>',
                    title: '<%= type === "error" ? "Error" : (type === "success" ? "Success" : (type === "warning" ? "Warning" : "Info")) %>',
                    text: '<%= msg %>',
                    confirmButtonColor: '#0d9488'
                });
            <% }); %>
        <% } %>
    <% }); %>
    </script>
